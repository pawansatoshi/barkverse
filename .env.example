# Never commit real secrets.
# BARKVERSE AI requires only OpenRouter for AI/vision.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openrouter/free
# Optional override; default is a verified free multimodal model.
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free

# Voice is optional; browser/local fallback works without it.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2
APP_URL=

# Solana is client-side devnet; no secret is required.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Snowflake SQL API is optional for the Observatory prize path.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_TOKEN=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_EVENTS_TABLE=BARK_EVENTS
